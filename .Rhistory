library(dplyr)
library(scoringutils)
library(ggplot2)
library(boot)
library(scales)
library(tidyr)
library(glmnet)
library(purrr)
setwd("~/attenuated-renewal")
metric_levels <- c("crps", "overprediction", "dispersion", "underprediction")
model_levels <- c("lrwP", "R_random5", "R_biased5", "expI2", "expI3", "sigmoidP3", "sigmoidP4", "sigmoidP6")
place_levels <- c("BCN", "LON", "MAD", "NYC", "SF", "HOMO", "HET", "SIM")
id_cols <- c("model_name", "network", "epi_phase", "tag", "f_week")
full_names <- c(lrwP="LRW", R_random5="RRAND", R_biased5="RBIAS", expI2="IGNORE", expI3="EXPI", expI4="EXPI", expI9="IGNORE", sigmoidP3="IGNORE", sigmoidP4="SIGT", sigmoidP5="IGNORE", sigmoidP6="IGNORE", sigmoidP7="SIGT", sigmoidP8="IGNORE", sigmoidP9="SIGT9")
output1 <- readRDS("fits_F2.rds")
output2 <- readRDS("fit2.rds")
divergences_df <- output$Rhat_df %>% filter(divergences >0 | max_Rhat > 1.05 | is.nan(max_Rhat))
CRPS_df <- output$CRPS_df %>%
mutate(model_name=full_names[model],
tag=ifelse(grepl("T", tag), as.numeric(stringr::str_extract_all(tag, "\\d+\\.?\\d*")), as.numeric(tag))) %>%
rename("predicted"="value") %>%
filter(model_name!="IGNORE")
fc <- as_forecast_sample(data = CRPS_df, observed = "true_infections", sample = "sample", forecast_unit = id_cols)
fc_log <- transform_forecasts(fc, offset = 1, append = FALSE, label = "log")
metrics     <- get_metrics(fc,     select = c("crps", "overprediction", "underprediction", "dispersion"))
metrics_log <- get_metrics(fc_log, select = c("crps", "overprediction", "underprediction", "dispersion"))
scoring_lin0 <- as.data.frame(score(fc,     metrics = metrics)) %>% mutate(measure="Linear CRPS")
scoring_log0 <- as.data.frame(score(fc_log, metrics = metrics)) %>% mutate(measure="Log CRPS")
scoring_results_raw0 <- rbind(scoring_lin0, scoring_log0) %>%
pivot_longer(cols = c(crps, overprediction, underprediction, dispersion), names_to = "metric", values_to = "value") %>%
mutate(model_name=factor(model_name, levels=unique(full_names)))
ggplot(scoring_results_raw0 %>% filter(network=="MSM_like", metric=="crps", measure=="Log CRPS", model_name %in% c("LRW", "EXPI", "RBIAS", "SIGT", "SIGT8"), f_week==3) %>% mutate(epi_phase=factor(epi_phase)), aes(x=model_name, y=value, fill=model_name)) +
geom_boxplot() +
theme_bw() +
facet_grid(network~epi_phase, scales="free") +
theme(panel.grid=element_blank())
ggplot(scoring_results_raw0 %>% filter(network=="MSM_like", metric=="crps", measure=="Log CRPS", model_name %in% c("LRW", "EXPI", "RBIAS", "SIGT9"), f_week==3) %>% mutate(epi_phase=factor(epi_phase)), aes(x=model_name, y=value, fill=model_name)) +
geom_boxplot() +
theme_bw() +
facet_grid(network~epi_phase, scales="free") +
theme(panel.grid=element_blank())
ggplot(scoring_results_raw0 %>% filter(value < 1e4, network=="MSM_like", metric=="crps", measure=="Linear CRPS", model_name %in% c("LRW", "EXPI", "RBIAS", "SIGT9"), f_week==3) %>% mutate(epi_phase=factor(epi_phase)), aes(x=model_name, y=value, fill=model_name)) +
geom_boxplot() +
theme_bw() +
facet_grid(network~epi_phase, scales="free") +
theme(panel.grid=element_blank())
scoring_results_raw0 %>% filter(f_week==3, metric=="crps") %>%
group_by(model_name, metric, network, measure) %>%
summarise(mean_value=mean(value)) %>%
tidyr::spread(network, mean_value) %>%
arrange(measure, MSM_like)
for(i in 0:9){
p <- ggplot(plotter_df %>% filter(epi_phase %in% c(1, 5, 10), model_name %in% c("LRW", "RBIAS", "SIGT9", "EXPI"), tag > 10*i, tag<=10*(i+1), network=="MSM_like", lower>1) %>% mutate(epi_phase=factor(epi_phase)), aes(x=day)) +
