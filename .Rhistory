fc <- as_forecast_sample(data = CRPS_df, observed = "true_infections", sample = "sample", forecast_unit = id_cols)
fc_log <- transform_forecasts(fc, offset = 1, append = FALSE, label = "log")
metrics     <- get_metrics(fc,     select = c("crps", "overprediction", "underprediction", "dispersion"))
metrics_log <- get_metrics(fc_log, select = c("crps", "overprediction", "underprediction", "dispersion"))
scoring_lin0 <- as.data.frame(score(fc,     metrics = metrics)) %>% mutate(measure="Linear CRPS")
scoring_log0 <- as.data.frame(score(fc_log, metrics = metrics)) %>% mutate(measure="Log CRPS")
scoring_results_raw0 <- rbind(scoring_lin0, scoring_log0) %>%
pivot_longer(cols = c(crps, overprediction, underprediction, dispersion), names_to = "metric", values_to = "value") %>%
mutate(model_name=factor(model_name, levels=unique(full_names)))
ggplot(scoring_results_raw0 %>% filter(network=="MSM_like", metric=="crps", measure=="Log CRPS", model_name %in% c("LRW", "EXPI", "RBIAS", "SIGT9"), f_week==3) %>% mutate(epi_phase=factor(epi_phase)), aes(x=model_name, y=value, fill=model_name)) +
geom_boxplot() +
theme_bw() +
facet_grid(network~epi_phase, scales="free") +
theme(panel.grid=element_blank())
scoring_results_raw0 %>% filter(f_week==3, metric=="crps") %>%
group_by(model_name, metric, network, measure) %>%
summarise(mean_value=mean(value)) %>%
tidyr::spread(network, mean_value) %>%
arrange(measure, MSM_like)
for(i in 0:9){
p <- ggplot(plotter_df %>% filter(epi_phase %in% c(1, 5, 10), model_name %in% c("LRW", "RBIAS", "SIGT9", "EXPI", "EXPI9"), tag > 10*i, tag<=10*(i+1), network=="hetero", lower>1) %>% mutate(epi_phase=factor(epi_phase)), aes(x=day)) +
geom_line(aes(y=median, color=epi_phase)) +
geom_ribbon(aes(ymin=lower, ymax=upper, fill=factor(epi_phase)), alpha=0.2) +
geom_point(aes(y=true_infections), color="black") +
theme_bw() +
facet_grid(model_name~tag, scales="free") +
theme(panel.grid=element_blank()) #+
#scale_y_log10()
print(p)
}
divergences_df <- output$Rhat_df %>% filter(divergences >0 | max_Rhat > 1.05 | is.nan(max_Rhat))
divergences_df
scoring_results_raw0 %>% filter(f_week==3, metric=="crps") %>%
group_by(model_name, metric, network, measure) %>%
summarise(mean_value=mean(value)) %>%
tidyr::spread(network, mean_value) %>%
arrange(measure, MSM_like)
scoring_results_raw0 %>% filter(f_week==3, metric=="crps") %>%
group_by(model_name, metric, network, measure) %>%
summarise(median_value=median(value)) %>%
tidyr::spread(network, median_value) %>%
arrange(measure, MSM_like)
full_names <- c(lrwP="LRW", R_random5="RRAND", R_biased5="RBIAS", expI2="IGNORE", expI3="EXPI", expI4="EXPI", expI9="IGNORE", sigmoidP3="IGNORE", sigmoidP4="SIGT", sigmoidP5="IGNORE", sigmoidP6="IGNORE", sigmoidP7="IGNORE", sigmoidP8="IGNORE", sigmoidP9="SIGT")
full_names
expI3 <- stan_model("functions/expI3.stan")
model_list <- list(expI9=expI9, sigmoidP9=sigmoidP9, expI3=expI3)
sim_files <- c(list.files("simulation2/homo/", full.names=T))
fit_files <- sim_files
fit_files
for(j in fit_files){
print(j)
simulation <- readRDS(j)
#cum_inc <- cumsum(simulation$outbreak$incidence_vector)
#tot_inc <- max(cum_inc)
#if(tot_inc < 500) next
inc <- simulation$outbreak$incidence_vector
cum_inc <- cumsum(inc)
tot_inc <- sum(inc)
peak_inc <- max(inc)
peak_inc_t <- which(inc==max(inc))
first_lower_3 <- which(inc<(peak_inc*0.03) & (1:length(inc)) > peak_inc_t)[1]
lower <- which(cum_inc > tot_inc * 0.05)[1]
upper <- which(cum_inc > tot_inc * 0.95)[1]-28 # first_lower_3#
times <- round(seq(lower, upper, length.out=10))
tag <- simulation$graph$tag
print(tag)
dir <- sub("^[^/]+/([^/]+)/.*", "\\1", j)
plot(simulation$outbreak$incidence_vector[1:(times[10]+28)])
for(i in times){
for(q in c("expI3")){#}, "sigmoidP9")){#names(model_list)){
print(i)
a7 <- fit_func2(simulation, model_name=q, cutoff=i, epi_phase=which(times==i), dir=dir, iter=1000, chains=4, tag=paste0(tag,"T"), keep_fit=F)
#plotting_func(a7)
}
}
}
files <- c(list.files("fits/sim/MSM_like/", full.names=T), list.files("fits/sim/homo/", full.names=T), list.files("fits/sim/hetero/", full.names=T))
files2 <- files[grepl(files, "expI3")]
files2 <- files[grepl("expI3", files)]
files2
for(i in files2){
print(which(files2==i), quote=F)
fit <- readRDS(i)
network <- sub(".*sim/([^/]+)/fit.*", "\\1", i)
tag <- as.numeric(gsub("T$", "", fit$tag))
Rhat_df_raw <- data.frame(file=i,
model=fit$model_name,
tag=tag,
epi_phase=fit$input_list$epi_phase,
cutoff=fit$cutoff,
max_Rhat=fit$max_Rhat,
iter=nrow(fit$forecast),
divergences=fit$total_divergences,
network=network)
idx <- round(seq(1, nrow(fit$infections), length.out = 100))
plotter_raw <- data.frame(day=1:(fit$input_list$N+fit$input_list$h),
true_infections=fit$incidence_full) %>%
mutate(lower=colQuantiles(fit$infections, prob=c(0.025)),
median=colQuantiles(fit$infections, prob=c(0.5)),
upper=colQuantiles(fit$infections, prob=c(0.975))) %>%
mutate(model=fit$model_name, tag=tag, epi_phase=fit$input_list$epi_phase, cutoff=fit$cutoff, network=network)
main_params_raw <- as.data.frame(fit$summary) %>%
mutate(model=fit$model_name, tag=tag, epi_phase=fit$input_list$epi_phase, cutoff=fit$cutoff, network=network)
CRPS_df_raw <- as.data.frame(t(fit$infections[idx,])) %>%
mutate(day=1:(fit$input_list$N+fit$input_list$h),
true_infections=fit$incidence_full) %>%
filter(day > fit$cutoff) %>%
mutate(f_week=floor((day-fit$cutoff-1)/7)) %>%
tidyr::gather("sample", "value", 1:(ncol(.)-3)) %>%
mutate(sample=as.numeric(sub("^V", "", sample))) %>%
group_by(sample, f_week) %>%
summarise(true_infections=sum(true_infections), value=sum(value), .groups="drop") %>%
mutate(model=fit$model_name, tag=tag, epi_phase=fit$input_list$epi_phase, cutoff=fit$cutoff, network=network)
if(i == files2[1]){
Rhat_df <- Rhat_df_raw
CRPS_df <- CRPS_df_raw
plotter <- plotter_raw
main_params <- main_params_raw
}
else{
Rhat_df <- rbind(Rhat_df, Rhat_df_raw)
CRPS_df <- rbind(CRPS_df, CRPS_df_raw)
plotter <- rbind(plotter, plotter_raw)
main_params <- rbind(main_params, main_params_raw)
}
}
saveRDS(object=list(Rhat_df=Rhat_df, CRPS_df=CRPS_df, plotter=plotter, main_params=main_params), file="fit_homoI3.rds")
